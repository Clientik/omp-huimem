{
  "name": "omp-huimem",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Project-local memory for oh-my-pi. File authority, versioned evidence, no background LLM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clientik/omp-huimem.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun build ./src/extensions/project-memory.ts --target=bun --format=esm --outfile ./dist/index.js",
    "test": "bun run build && bun test ./tests",
    "check": "bun run test && bun run scripts/check-package.ts"
  },
  "files": [
    "dist",
    "skills",
    "skills-lock.json",
    "starter",
    "README.md",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ]
}

