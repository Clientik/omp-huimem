# Универсальный интерфейс команд для агента — дешевле, чем угадывать shell-команды каждый раз.
# Заполнить под проект, оставить только реально нужные цели.
#
# ВАЖНО: незаполненные цели ПАДАЮТ, а не печатают TODO с кодом 0.
# Прежняя версия делала `@echo "TODO: ..."` и возвращала успех — агент мог честно
# запустить `make test`, получить код 0 и доложить, что проверки прошли, хотя не
# выполнялось ничего. Незаполненная настройка должна выглядеть как незаполненная.

.PHONY: setup test start dev lint build

TODO = @echo "ЦЕЛЬ '$@' НЕ НАСТРОЕНА. Впишите команду в Makefile." >&2; exit 2

setup:
	$(TODO)

test:
	$(TODO)

start:
	$(TODO)

dev:
	$(TODO)

lint:
	$(TODO)

build:
	$(TODO)
